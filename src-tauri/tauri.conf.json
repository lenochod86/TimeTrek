{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeTrek",
  "version": "0.1.3",
  "identifier": "com.timetrek.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TimeTrek",
        "width": 1400,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "installerHooks": "windows/hooks.nsh" } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
