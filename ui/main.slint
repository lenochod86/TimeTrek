import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { T } from "texts.slint";
import { Icons, IconPath, IconButton, WindowButton } from "widgets.slint";
import { Nav, Tip, Preview, TagDlg, Confirm, SettingsState, AboutState, UpdateState } from "state.slint";
import { TtButton } from "widgets.slint";
import { DayPage } from "day.slint";
import { StatsPage } from "stats.slint";
import { ReportsPage } from "reports.slint";
import { TagDialog, ConfirmDialog, SettingsDialog, AboutDialog, ViewerDialog, PreviewPopup } from "dialogs.slint";

export { Nav, Tip, Preview, TagDlg, Confirm, SettingsState, AboutState, UpdateState, Theme, T }
export { DayState, RangeState, DateD, Calendar, StatsState, ReportsState, TickD, TagLabelD, RowD, RankD, ChipD, StatRowD, DayBarD, BarRowD, HeatD } from "state.slint";

component Tab inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> index;
    private property <bool> active: Nav.tab == index;
    background: ta.has-hover ? Theme.hover-faint : transparent;
    min-width: label.preferred-width + 28px + 16px + 7px;
    max-width: label.preferred-width + 28px + 16px + 7px;
    ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { Nav.tab = root.index; Nav.tab-changed(root.index); } }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 7px;
        IconPath { y: (parent.height - self.height) / 2; d: root.icon; tint: active ? Theme.accent : Theme.text; }
        label := Text { text: root.text; color: active ? Theme.accent : Theme.text; vertical-alignment: center; }
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: active ? Theme.accent : transparent;
    }
}

// Neviditelný proužek na okraji okna, za který se mění velikost.
component ResizeEdge inherits Rectangle {
    in property <int> dir;
    in property <MouseCursor> cursor;
    TouchArea {
        mouse-cursor: root.cursor;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                Nav.resize-window(root.dir);
            }
        }
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    title: "TimeTrek";
    icon: @image-url("../assets/icon/timetrek-128.png");
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;
    default-font-size: 13px;
    // Software renderer kreslí text bez ClearType a bez hintingu, takže je tenčí než v prohlížeči;
    // střední váha to vyrovná (Segoe UI Variable Text má plynulou osu váhy, jako původní UI).
    default-font-family: "Segoe UI Variable Text";
    default-font-weight: 500;

    in-out property <bool> dark <=> Theme.dark;
    changed dark => { Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light; }
    init => { Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light; }

    // Po zavření dialogu se klávesy (F11, F12, Esc) vracejí ke společnému FocusScope.
    private property <bool> dialog-open: TagDlg.open || Confirm.open || SettingsState.open || AboutState.open;
    changed dialog-open => { if !self.dialog-open { fs.focus(); } }

    forward-focus: fs;
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.F11 { Preview.toggle-lock(); return accept; }
            if e.text == Key.F12 { Preview.toggle-viewer(); return accept; }
            if e.text == Key.Escape { Preview.escape(); return accept; }
            if Preview.viewer-open && e.text == Key.LeftArrow { Preview.viewer-step(-1); return accept; }
            if Preview.viewer-open && e.text == Key.RightArrow { Preview.viewer-step(1); return accept; }
            if Preview.viewer-open && e.text == Key.Home { Preview.viewer-step(-1000000); return accept; }
            if Preview.viewer-open && e.text == Key.End { Preview.viewer-step(1000000); return accept; }
            reject
        }
        VerticalLayout {
            // horní lišta: záložky vlevo, přepínač motivu, nastavení a o aplikaci vpravo
            Rectangle {
                height: 38px;
                HorizontalLayout {
                    padding-left: 6px;
                    spacing: 2px;
                    Tab { text: T.tab-day; icon: Icons.day; index: 0; }
                    Tab { text: T.tab-stats; icon: Icons.stats; index: 1; }
                    Tab { text: T.tab-reports; icon: Icons.reports; index: 2; }
                    // Volná část lišty: tažení okna, dvojklik maximalizuje.
                    Rectangle {
                        horizontal-stretch: 1;
                        TouchArea {
                            pointer-event(e) => {
                                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                    Nav.drag-window();
                                }
                            }
                            double-clicked => { Nav.toggle-maximize(); }
                        }
                    }
                    IconButton {
                        d: Theme.dark ? Icons.sun : Icons.moon;
                        clicked => { Nav.toggle-theme(); }
                    }
                    IconButton {
                        d: Icons.gear;
                        grid: 24;
                        thickness: 1.9px;
                        clicked => { Nav.show-settings(); }
                    }
                    IconButton { d: Icons.info; clicked => { Nav.show-about(); } }
                    Rectangle {
                        width: 13px;
                        Rectangle { width: 1px; x: 6px; y: 9px; height: parent.height - 18px; background: Theme.line; }
                    }
                    WindowButton { d: Icons.minimize; clicked => { Nav.minimize-window(); } }
                    WindowButton { d: Icons.maximize; clicked => { Nav.toggle-maximize(); } }
                    WindowButton { d: Icons.close; danger: true; clicked => { Nav.close-window(); } }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.dark ? #ffffff : Theme.line;
                }
            }
            if UpdateState.offer: Rectangle {
                height: 46px;
                background: Theme.panel-2;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: UpdateState.busy || UpdateState.progress != "" ? UpdateState.progress : UpdateState.text;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TtButton {
                        text: UpdateState.download-label;
                        primary: true;
                        enabled: !UpdateState.busy;
                        clicked => { UpdateState.download(); }
                    }
                    TtButton {
                        text: T.update-snooze;
                        enabled: !UpdateState.busy;
                        clicked => { UpdateState.snooze(); }
                    }
                    TtButton {
                        text: T.update-skip;
                        enabled: !UpdateState.busy;
                        clicked => { UpdateState.skip(); }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.accent; }
            }
            Rectangle {
                vertical-stretch: 1;
                if Nav.tab == 0: DayPage { }
                if Nav.tab == 1: StatsPage { }
                if Nav.tab == 2: ReportsPage { }
            }
        }
    }

    // vrstvy nad obsahem
    if Preview.visible && !Preview.viewer-open: PreviewPopup { win-width: root.width; win-height: root.height; }
    if Preview.viewer-open: ViewerDialog { win-width: root.width; win-height: root.height; }
    if TagDlg.open: TagDialog { }
    if Confirm.open: ConfirmDialog { }
    if SettingsState.open: SettingsDialog { }
    if AboutState.open: AboutDialog { }
    if Tip.text != "": Rectangle {
        x: max(8px, min(Tip.x + 14px, parent.width - self.width - 8px));
        y: Tip.y + 18px;
        width: min(tip-text.preferred-width + 20px, 460px);
        height: tip-text.preferred-height + 12px;
        background: Theme.pop-bg;
        border-width: 1px;
        border-color: Theme.pop-border;
        border-radius: 6px;
        tip-text := Text {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            text: Tip.text;
            color: Theme.text;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    // okraje pro změnu velikosti a jemný obrys okna (okno nemá systémový rám)
    ResizeEdge { x: 0px; y: 0px; width: parent.width; height: 4px; dir: 0; cursor: MouseCursor.ns-resize; }
    ResizeEdge { x: 0px; y: parent.height - 4px; width: parent.width; height: 4px; dir: 1; cursor: MouseCursor.ns-resize; }
    ResizeEdge { x: 0px; y: 0px; width: 4px; height: parent.height; dir: 2; cursor: MouseCursor.ew-resize; }
    ResizeEdge { x: parent.width - 4px; y: 0px; width: 4px; height: parent.height; dir: 3; cursor: MouseCursor.ew-resize; }
    ResizeEdge { x: 0px; y: 0px; width: 10px; height: 10px; dir: 4; cursor: MouseCursor.nwse-resize; }
    ResizeEdge { x: parent.width - 10px; y: 0px; width: 10px; height: 10px; dir: 5; cursor: MouseCursor.nesw-resize; }
    ResizeEdge { x: 0px; y: parent.height - 10px; width: 10px; height: 10px; dir: 6; cursor: MouseCursor.nesw-resize; }
    ResizeEdge { x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px; dir: 7; cursor: MouseCursor.nwse-resize; }
    Rectangle {
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: Theme.dark ? #3a3a3a : #b8bec6;
        background: transparent;
    }
}
